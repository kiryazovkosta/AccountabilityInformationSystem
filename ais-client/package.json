{
  "name": "ais-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build-info": "node scripts/generate-build-info.mjs",
    "start": "ng serve",
    "prebuild": "npm run build-info",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/localize": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/tailwindcss": "^3.0.11",
    "baseline-browser-mapping": "^2.9.19",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
